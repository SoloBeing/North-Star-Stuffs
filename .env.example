# DigiLocker Partner API. Leave unset to run the built-in mock provider.
# DIGILOCKER_CLIENT_ID=
# DIGILOCKER_CLIENT_SECRET=
# DIGILOCKER_REDIRECT_URI=https://your-domain/api/digilocker/callback

# Gemini — only used by V1 generic mode. Template mode never calls it.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Only needed if the app and API are served from different hosts in production.
# FORMMITRA_FRONTEND_URL=https://your-app.vercel.app
# FORMMITRA_ALLOWED_ORIGINS=https://your-app.vercel.app
