# DigiLocker Partner API. Leave unset to run the built-in mock provider.
# DIGILOCKER_CLIENT_ID=
# DIGILOCKER_CLIENT_SECRET=
# DIGILOCKER_REDIRECT_URI=https://your-domain/api/digilocker/callback

# Gemini — only used by V1 generic mode. Template mode never calls it.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Signs the mock DigiLocker provider's session tokens, which serverless needs
# because it keeps no memory between requests. Optional: the fallback key
# protects nothing (the mock's payload is the demo citizen, already public in
# this repo), but setting it stops one deployment's tokens working on another.
# FORMMITRA_SECRET_KEY=

# Only needed if the app and API are served from different hosts in production.
# The Vercel deploy puts both on one origin, so neither of these applies there.
# FORMMITRA_FRONTEND_URL=https://your-app.vercel.app
# FORMMITRA_ALLOWED_ORIGINS=https://your-app.vercel.app
