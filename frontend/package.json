{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "check": "npm run lint && npm run check:ui && npm run test:ui && npm run check:text && npm run test:text && npm run check:contrib && npm run test:contrib && npm run context:check",
    "check:all": "npm run check && npm run test:rules",
    "check:ui": "node scripts/check-ui.mjs",
    "test:ui": "node scripts/check-ui.test.mjs",
    "check:text": "node scripts/check-text.mjs",
    "test:text": "node scripts/check-text.test.mjs",
    "check:contrib": "node scripts/check-contribution.mjs",
    "test:contrib": "node scripts/check-contribution.test.mjs",
    "test:rules": "node scripts/check-rule-parity.mjs",
    "context": "node scripts/build-context-packs.mjs",
    "context:check": "node scripts/build-context-packs.mjs --check"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "vite": "^8.2.0"
  }
}
