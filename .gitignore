# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Node
node_modules/
frontend/dist/
frontend/dev-dist/

# Secrets — never commit API keys
.env
.env.*
!.env.example

# Session transcripts are written automatically and log raw command output,
# which on a public repo means every push needs a secret scan first. The
# hand-written story of the build lives in docs/build-log/ instead.
session_transcripts/

# Vercel's local project link and the token it pulls down.
# `vercel link` also appends its own `.env*` here, which must be deleted if it
# comes back: it sits *below* the `!.env.example` exception above, and the last
# matching rule wins, so it silently re-ignores the one env file we do commit.
.vercel
